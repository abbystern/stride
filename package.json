  },
  "homepage": "https://github.com/abbystern/stride#readme",
  "dependencies": {
    "@playwright/test": "^1.64.1",
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
