{
  "name": "stride",
  "version": "1.0.0",
  "description": "An all-in-one fitness app for planning workouts, tracking running and strength training, logging nutrition, and monitoring recovery.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5000",
    "test:workout-validation": "node --experimental-strip-types --test tests/workout-validation.test.ts",
    "test:workout-filters": "node --experimental-strip-types --test tests/workout-filters.test.ts",
    "test:dashboard": "node --experimental-strip-types --test tests/dashboard.test.ts",
    "test:workout-ui": "playwright test"
  },
